": "നിങ്ങളുടെ ഉപയോക്തൃനാമം നൽകുക. ഒരിക്കൽ ഉപയോഗിക്കാവുന്ന 6 അക്ക കോഡ് നിങ്ങളുടെ അഡ്മിനിസ്ട്രേറ്റർ നൽകും (അല്ലെങ്കിൽ ഈ സെർവറിൽ ഇ-മെയിൽ സജ്ജമാണെങ്കിൽ ഇ-മെയിൽ ചെയ്യും).", "requestResetCode": "റീസെറ്റ് കോഡ് അഭ്യർത്ഥിക്കുക", "requestingCode": "കോഡ് അഭ്യർത്ഥിക്കുന്നു…", "resetOfflineNote": "ഓഫ്‌ലൈനായി പ്രവർത്തിക്കുന്നു: SMS അല്ലെങ്കിൽ പണമടച്ചുള്ള ഇ-മെയിൽ സേവനമില്ല. നിങ്ങളുടെ സ്വകാര്യതയ്ക്കായി, ഒരു ഉപയോക്തൃനാമം നിലവിലുണ്ടോ എന്ന് ഞങ്ങൾ ഒരിക്കലും പറയില്ല.", "enterCodeTitle": "നിങ്ങളുടെ കോഡ് നൽകുക", "codeFor": "{username}-നുള്ള കോഡ് · {minutes} മിനിറ്റ് സാധുത", "resetCodeLabel": "6 അക്ക റീസെറ്റ് കോഡ്", "otpDigit": "{count}-ൽ അക്കം {index}", "newPassword": "പുതിയ പാസ്‌വേഡ്", "passwordStrength": "ശക്തി: {level}", "strengthWeak": "ദുർബലം", "strengthFair": "തരക്കേടില്ല", "strengthGood": "നല്ലത്", "strengthStrong": "ശക്തം", "passwordHint": "കുറഞ്ഞത് 8 അക്ഷരങ്ങൾ. നിങ്ങളുടെ ഉപയോക്തൃനാമമല്ല, സാധാരണ പാസ്‌വേഡുമല്ല.", "setNewPassword": "പുതിയ പാസ്‌വേഡ് സജ്ജമാക്കുക", "settingPassword": "സംരക്ഷിക്കുന്നു…", "requestNewCode": "പുതിയ കോഡ് അഭ്യർത്ഥിക്കുക", "passwordUpdated": "പാസ്‌വേഡ് പുതുക്കി", "signedOutEverywhere": "മറ്റെല്ലാ ഉപകരണങ്ങളിൽ നിന്നും നിങ്ങളെ സൈൻ ഔട്ട് ചെയ്തു.", "invalidResetCode": "അസാധുവായ അല്ലെങ്കിൽ കാലഹരണപ്പെട്ട കോഡ്", "codeIncomplete": "കോഡിന്റെ 6 അക്കങ്ങളും നൽകുക.", "passwordTooShort": "പാസ്‌വേഡിന് കുറഞ്ഞത് 8 അക്ഷരങ്ങൾ വേണം.", "passwordSameAsUsername": "പാസ്‌വേഡ് ഉപയോക്തൃനാമം പോലെയാകരുത്.", "passwordTooCommon": "ഈ പാസ്‌വേഡ് വളരെ സാധാരണമാണ്. മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക.", "resetError": "നിങ്ങളുടെ പാസ്‌വേഡ് റീസെറ്റ് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.",
