# Do not commit a real .env file.
POSTGRES_DB=packcomply
POSTGRES_USER=packcomply
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://packcomply:change-me-for-local-development@localhost:5432/packcomply
BACKEND_PORT=8000
FRONTEND_PORT=5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
OCR_MAX_IMAGE_DIMENSION=1280
OCR_SECONDARY_LANGUAGE_MAX_IMAGE_DIMENSION=960
OCR_SECONDARY_LANGUAGE_TIMEOUT_SECONDS=90
OCR_RECOGNITION_BATCH_SIZE=8
# Comma-separated PaddleOCR 3.x language codes enabled for this project.
# UI languages are separate; do not add a UI locale here unless PaddleOCR supports it.
# en=English, hi=Hindi, gom=Konkani, mai=Maithili, mr=Marathi, ne=Nepali,
# sa=Sanskrit, ta=Tamil, te=Telugu, ur=Urdu, ka=Kannada.
# Each extra language adds processing time.
OCR_LANGUAGES=en,hi
# Optional PaddleOCR model names (empty = PaddleOCR defaults), e.g. PP-OCRv5_mobile_det.
OCR_DETECTION_MODEL=
OCR_RECOGNITION_MODEL=
# oneDNN CPU acceleration for the recognition models (detection cannot use it
# on Windows with paddlepaddle 3.3.1). ~2.4x faster; auto-falls back if it fails.
OCR_ENABLE_MKLDNN=true
# 0 = library default thread count.
OCR_CPU_THREADS=0
# Re-read a photo taken sideways turned 90 / 270 degrees (two extra passes, only for sideways photos).
OCR_AUTO_ROTATE=true
# Load OCR models in the background when the API starts.
OCR_WARMUP_ON_STARTUP=true
# Copy the versioned compliance ruleset into the database when the API starts.
COMPLIANCE_RULES_SYNC_ON_STARTUP=true
SESSION_COOKIE_NAME=packcomply_session
SESSION_TTL_HOURS=12
# True when served over HTTPS.
SESSION_SECURE=false
# Public registration creates MANUFACTURER accounts only. Set true to let anyone
# self-register as OFFICIAL (local demos only). Otherwise use:
#   python -m backend.scripts.create_user --role OFFICIAL
ALLOW_OFFICIAL_SELF_REGISTRATION=false
# Failed logins per (username, IP) before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
