# Do not commit a real .env file.
POSTGRES_DB=packcomply
POSTGRES_USER=packcomply
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://packcomply:change-me-for-local-development@localhost:5432/packcomply
BACKEND_PORT=8000
FRONTEND_PORT=5173
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
OCR_MAX_IMAGE_DIMENSION=640
OCR_SECONDARY_LANGUAGE_MAX_IMAGE_DIMENSION=320
OCR_SECONDARY_LANGUAGE_TIMEOUT_SECONDS=45
OCR_RECOGNITION_BATCH_SIZE=8
# Comma-separated PaddleOCR 3.x language codes enabled for this project.
# UI languages are separate; do not add a UI locale here unless PaddleOCR supports it.
# en=English, hi=Hindi, gom=Konkani, mai=Maithili, mr=Marathi, ne=Nepali,
# sa=Sanskrit, ta=Tamil, te=Telugu, ur=Urdu, ka=Kannada.
OCR_LANGUAGES=en,hi,gom,mai,mr,ne,sa,ta,te,ur,ka
SESSION_COOKIE_NAME=packcomply_session
SESSION_TTL_HOURS=12
# True when served over HTTPS.
SESSION_SECURE=false
